# Copy this file to .env and add your private Google AI Studio key locally.
GEMINI_API_KEY=replace_with_your_private_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Account authentication: generate a private key with
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
BHUMILIPI_AUTH_DB=

# Email verification codes (SMTP). Use an app password where your mail host supports it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Phone verification codes (Twilio SMS). Keep these values private.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
